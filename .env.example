# ─────────────────────────────────────────────────────────────
# AIContacts — configuration. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# Port the app listens on (host:container is mapped in docker-compose).
PORT=8787

# Public origin where this app is reached (used for the OAuth redirect and
# to enable secure cookies). Required for Google login. No trailing slash.
PUBLIC_URL=https://contacts.example.com

# ── AI provider (your own key stays server-side) ──
# anthropic | openai | gemini  (blank = email-derived data only)
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional model overrides. Defaults: claude-sonnet-4-6 / gpt-4o / gemini-2.0-flash
AI_MODEL=
# Optional stronger model used only for "Deep check" passes.
AI_MODEL_DEEP=
# Use the provider's web-search grounding (recommended). false to disable.
AI_WEB_SEARCH=true
AI_TIMEOUT_MS=60000

# ── Google login + Contacts sync ──
# Create an OAuth client (Web application) in Google Cloud Console, enable the
# People API, and set the redirect URI to  <PUBLIC_URL>/auth/google/callback.
# Leave these blank to run in single-user local mode (CSV only, no login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Google emails may sign in (comma-separated). Empty = nobody.
ALLOWED_EMAILS=you@example.com
# Optional: override the redirect if it isn't <PUBLIC_URL>/auth/google/callback
# OAUTH_REDIRECT_URL=

# ── Secrets / cookies ──
# Secret for session cookies + token encryption. If blank, a persistent random
# one is generated under DATA_DIR so logins survive restarts. Set it to share a
# value across replicas.
SESSION_SECRET=
# Set true to force Secure cookies (auto-on when PUBLIC_URL is https).
# COOKIE_SECURE=true
SESSION_TTL_DAYS=30

# ── Optional outer shared-password gate (in front of Google login) ──
# Set AUTH_PASSWORD to require HTTP Basic Auth before anything loads.
AUTH_USER=admin
AUTH_PASSWORD=

# Where SQLite + the generated secret live (mounted as a volume in compose).
DATA_DIR=/data
